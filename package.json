{
  "name": "agent-hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "npm run build -w web && wrangler dev --port 43123 --ip 0.0.0.0",
    "dev:web": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "agent:key": "npm run agent:key -w server --"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
