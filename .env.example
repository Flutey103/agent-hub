# Browser build (Vite reads VITE_* from this file). Leave VITE_SERVER_URL unset
# when the UI is served by the Worker so requests stay on the same origin.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Worker runtime. On Cloudflare these are vars (PUBLIC_URL, DEFAULT_LEASE_MINUTES,
# RUNNER_ENABLED) or secrets (everything else). See DEPLOY.md.
# For `wrangler dev`, put the secrets in .dev.vars or in this file.
PUBLIC_URL=https://agent-hub.flutey103.workers.dev
DEFAULT_LEASE_MINUTES=30
RUNNER_ENABLED=true

# Provider keys for headless agents. Leave blank to disable that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
