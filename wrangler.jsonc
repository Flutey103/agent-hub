{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-hub",
  "main": "server/src/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Replaces the Node setInterval tick (SCHEDULER_INTERVAL_MINUTES). UTC.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "18f7ffed2fd24c7c8bccb4089c266966"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The marketing site and the signed-in app are the SPA (/, /login, /home, …).
    // Only OAuth and API paths run the Worker first, so index.html cannot swallow them.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*"]
  },
  "vars": {
    "PUBLIC_URL": "https://agent-hub.flutey103.workers.dev",
    "DEFAULT_LEASE_MINUTES": "30",
    "RUNNER_ENABLED": "true"
  }
}
